{
  "name": "planner-mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "planner-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "sync:blocks": "node -e \"require('fs').copyFileSync('../src/lib/blocks.ts','src/lib/blocks.ts')\"",
    "build": "npm run sync:blocks && tsc",
    "start": "node dist/index.js",
    "pm:serve": "npm run sync:blocks && tsc && node dist/pmServe.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
